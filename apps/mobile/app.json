{
  "expo": {
    "name": "Abhyas",
    "slug": "abhyas",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "abhyas",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0E1116",
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.studysync.abhyas",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0E1116"
      }
    },
    "web": { "bundler": "metro", "output": "single" },
    "_comment_auth": "google-signin plugin: set EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID before prebuild; Android needs the debug+release SHA-1 fingerprints registered in Google Cloud Console (see docs/P2-AUTH-SETUP.md).",
    "plugins": [
      "expo-router",
      ["@react-native-google-signin/google-signin", {}]
    ],
    "experiments": { "typedRoutes": true }
  }
}
