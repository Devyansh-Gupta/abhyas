{
  "type": "object",
  "required": ["id", "board", "class", "subject", "emoji", "acadYear", "version", "kind", "topics"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9·]+·class\\d+·[a-z][a-z-]*@\\d{4}-\\d{2}$" },
    "board": { "type": "string" },
    "class": { "type": "integer", "minimum": 5, "maximum": 12 },
    "subject": { "type": "string" },
    "emoji": { "type": "string", "minLength": 1 },
    "acadYear": { "pattern": "^\\d{4}-\\d{2}$" },
    "version": { "type": "string" },
    "kind": { "enum": ["core", "elective", "additional"] },
    "weight": { "type": "number" },
    "_note": { "type": "string" },
    "topics": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "_doc": "STABLE across years — renames keep the id; deletions drop it; additions mint a new one" },
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "weight": { "type": "number" }
        }
      }
    }
  }
}
